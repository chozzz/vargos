{
  "$schema": "distill-jsonl-conversation-config-v1",
  "inputs": [
    "/absolute/path/to/conversations/**/*.jsonl"
  ],
  "output_root": "/absolute/path/to/output/distilled/conversations",
  "run_slug": "conversation-distill-YYYY-MM-DD",
  "project": {
    "name": "MyProject",
    "slug": "myproject",
    "optional_root": "/absolute/path/to/repo-or-null"
  },
  "mcps": {
    "github": {
      "enabled": false,
      "repo": "org/repo"
    },
    "jira": {
      "enabled": false,
      "project_key": "PROJ"
    },
    "confluence": {
      "enabled": false,
      "space_key": "PROJ"
    }
  },
  "lanes": {
    "schema-map": true,
    "project-knowledge": true,
    "user-preferences": true,
    "distillation-strategy": true,
    "workflows-runbooks": true,
    "issues-lessons": true,
    "sft-candidates": false,
    "index": true
  },
  "privacy": {
    "redact_secrets": true,
    "redact_personal_data": true,
    "redact_internal_urls": false,
    "allow_short_quotes": true,
    "max_quote_chars": 240
  },
  "hints": {
    "date_range": "all",
    "focus_projects": [],
    "ignore_projects": [],
    "preference_scopes": [
      "coding",
      "communication",
      "workflow",
      "tooling",
      "training-data"
    ],
    "minimum_confidence": "medium"
  },
  "notes": [
    "All MCPs are optional and disabled by default.",
    "Prefer CPT markdown outputs. Enable sft-candidates only when you want clean behavioral examples.",
    "Conversations can contain wrong assistant claims. User statements and tool outputs rank above assistant prose.",
    "Use output_root/project/run_slug if you want one folder per project."
  ]
}